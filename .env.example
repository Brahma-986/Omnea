# =============================================================================
# Omnea Procure OS - Environment Configuration Example
# Suitable for Local Development, Render, Docker, and Vercel Serverless (Hobby)
# =============================================================================

# Application Environment
APP_NAME=omnea-procure-os
APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default

# -----------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 with pgvector)
# -----------------------------------------------------------------------------
# Option A: Full Connection String (Recommended for Supabase, Neon, or Vercel Postgres)
# Supabase Transaction Pooler (Port 6543): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Neon Direct / Pooled URL: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Option B: Vercel Postgres injected alias (automatically recognized if set)
# POSTGRES_URL=postgresql://user:password@hostname:5432/dbname

# Option C: Discrete parameters (for local Docker / docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=procure_os

# Enable NullPool connection management (automatically enabled when VERCEL=1)
DB_SERVERLESS_POOL=false

# -----------------------------------------------------------------------------
# 2. AI / Large Language Model (Gemini / OpenAI / Anthropic)
# -----------------------------------------------------------------------------
# Google AI Studio Gemini API Key (Free tier: 15 RPM, 1500 RPD, zero card required)
# Both GEMINI_API_KEY and LLM_API_KEY are supported
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-1.5-flash

# Spend Protections & Budget Guardrails (Hard enforcement)
LLM_GLOBAL_DAILY_BUDGET_USD=25.00
LLM_TENANT_DAILY_BUDGET_USD=5.00

# -----------------------------------------------------------------------------
# 3. Cryptographic Security & Authentication
# -----------------------------------------------------------------------------
# Generate strong 256-bit random keys: openssl rand -hex 32
JWT_SECRET=generate_strong_secret_key_minimum_32_characters_long
JWT_SECRET_KEY=generate_strong_secret_key_minimum_32_characters_long
CSRF_SECRET_KEY=generate_strong_secret_key_minimum_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 4. CORS & Frontend Domains
# -----------------------------------------------------------------------------
# Automatically allows https://*.vercel.app in addition to origins below
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# 5. Object Storage (S3-Compatible: Supabase Storage / Cloudflare R2 / AWS S3)
# -----------------------------------------------------------------------------
# Supabase S3 Endpoint: https://<project-ref>.supabase.co/storage/v1/s3
# Cloudflare R2 Endpoint: https://<account_id>.r2.cloudflarestorage.com
# AWS S3: leave S3_ENDPOINT empty
S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_storage_access_key
S3_SECRET_ACCESS_KEY=your_storage_secret_key
S3_REGION_NAME=us-east-1
S3_BUCKET_ATTACHMENTS=procure-attachments
S3_PRESIGNED_EXPIRATION_SECONDS=3600

# -----------------------------------------------------------------------------
# 6. Email Delivery Provider (Resend / Postmark / AWS SES / Fake)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=notifications@yourdomain.com

# -----------------------------------------------------------------------------
# 7. Rate Limiting Protection (Sliding-Window Middleware)
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=1200
RATE_LIMIT_TENANT_PER_MIN=300
RATE_LIMIT_IP_PER_MIN=120

# -----------------------------------------------------------------------------
# 8. External Integrations (Optional / Simulated in Free Tier)
# -----------------------------------------------------------------------------
# Neo4j Graph Database (Neo4j AuraDB Free tier or local container)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Temporal Orchestration (Temporal Cloud or local server)
TEMPORAL_TARGET_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Slack App Integration (Optional)
SLACK_SIGNING_SECRET=test_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-test-token
