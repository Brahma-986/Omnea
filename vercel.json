{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "public"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "index.py",
      "bindings": [
        {
          "type": "service",
          "service": "workers",
          "format": "url",
          "env": "WORKERS_URL"
        }
      ]
    },
    "workers": {
      "root": "deploy/workers",
      "framework": "fastapi",
      "entrypoint": "index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/invitations(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/status",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/events/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
