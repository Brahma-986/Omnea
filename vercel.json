{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "buildCommand": "npm run build",
      "outputDirectory": "public"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/index.py",
      "bindings": [
        {
          "type": "service",
          "service": "workers",
          "format": "url",
          "env": "WORKERS_URL"
        }
      ]
    },
    "workers": {
      "root": "services/workers",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/status",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/events/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
