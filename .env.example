# =============================================================================
# Omnea Procure OS - Environment Variable Template
# Copy this file to .env and supply your credentials before deploying to Vercel
# =============================================================================

# Application Configuration
APP_NAME=omnea-procure-os
APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default

# Database Configuration (Supabase Transaction Pooler, Port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.lldvxuigljlbotibbeet:YOUR_SUPABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres.lldvxuigljlbotibbeet:YOUR_SUPABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_SERVERLESS_POOL=true
VERCEL=1

# Database Internal Role Passwords
PROCURE_APP_PASSWORD=procure_app_secret_pass_2026
PROCURE_ADMIN_PASSWORD=procure_admin_secret_pass_2026
PROCURE_WORKFLOW_PASSWORD=procure_workflow_secret_pass_2026
PROCURE_REVIEWER_PASSWORD=procure_reviewer_secret_pass_2026
PROCURE_INGEST_PASSWORD=procure_ingest_secret_pass_2026

# AI / Large Language Model (Google AI Studio Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-1.5-flash
LLM_GLOBAL_DAILY_BUDGET_USD=25.00
LLM_TENANT_DAILY_BUDGET_USD=5.00

# Cryptographic Security & Authentication (Generate with `openssl rand -hex 32`)
JWT_SECRET=generate_strong_secret_key_minimum_32_characters_long
JWT_SECRET_KEY=generate_strong_secret_key_minimum_32_characters_long
CSRF_SECRET_KEY=generate_strong_secret_key_minimum_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Safeguards
RATE_LIMIT_GLOBAL_PER_MIN=1200
RATE_LIMIT_TENANT_PER_MIN=300
RATE_LIMIT_IP_PER_MIN=120

# Email Delivery Provider (fake, resend, postmark, ses)
EMAIL_PROVIDER=fake
RESEND_API_KEY=re_placeholder_for_free_tier
EMAIL_FROM_ADDRESS=notifications@omnea.ai

# Object Storage (Supabase S3-Compatible Storage)
S3_ENDPOINT=https://lldvxuigljlbotibbeet.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=https://lldvxuigljlbotibbeet.supabase.co/storage/v1/s3
S3_REGION_NAME=ap-northeast-1
S3_BUCKET_ATTACHMENTS=procure-attachments
S3_ACCESS_KEY_ID=lldvxuigljlbotibbeet
S3_SECRET_ACCESS_KEY=your_supabase_service_role_key

# Optional Backing Service Fallbacks
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
TEMPORAL_TARGET_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
